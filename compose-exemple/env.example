# ============================================================================
# Scribae — les variables du PREMIER démarrage (copiez en « .env »).
#
#   cp env.example .env
#
# Ce fichier contient des secrets : il ne se versionne pas, et se sauvegarde à
# part. Trois valeurs sont à renseigner avant le premier `docker compose up -d` :
# DB_ROOT_PASSWORD, DB_PASSWORD et ADMIN_PASSWORD. Tout le reste a un défaut
# utilisable, et les autres réglages (identité, vocabulaire, numérotation,
# délais, recueil, bulletins, annuaire…) se découvrent dans `src/docs/VARIABLES.md`
# et se règlent depuis l'écran Administration — inutile de les écrire d'avance.
#
# RÈGLE DE RÉDACTION (celle du dépôt) : un commentaire occupe TOUJOURS sa propre
# ligne. Un commentaire en fin de ligne n'est retiré que par certaines versions du
# lecteur de `.env` (docker compose, systemd, busybox…) : la valeur partirait
# alors avec le « # » et le commentaire collés.
# ============================================================================

# --- La base de données ------------------------------------------------------

# Mot de passe du compte d'ADMINISTRATION de MariaDB. Il est posé à la création
# du volume de données, et ne se change plus ensuite : pour le rejouer, il faut
# repartir d'un volume vierge (`docker compose down -v`, qui SUPPRIME les
# données). Il sert aussi, à chaque démarrage de Scribae, à remettre le compte
# applicatif au mot de passe ci-dessous puis à appliquer le schéma.
DB_ROOT_PASSWORD=

DB_NAME=scriba

DB_USER=scriba

# Mot de passe du compte APPLICATIF. Celui-ci peut être changé à tout moment :
# il est réappliqué au démarrage du conteneur `scribae`, et la base suit.
# Générer un mot de passe : `openssl rand -base64 24`.
DB_PASSWORD=

# --- L'accès ----------------------------------------------------------------

# Port publié sur l'hôte. Mettez Scribae derrière un reverse proxy avec TLS en
# production (voir `src/docs/ADMINISTRATION.md`).
HTTP_PORT=8080

# `password` : comptes locaux, vérifiés par le service (le mode d'un service
#              réel) ;
# `demo`     : comptes de l'application choisis sans mot de passe — un essai,
#              jamais un service.
AUTH_MODE=password

# Le cookie de session n'est transmis qu'en HTTPS tant que ce réglage est à
# `true` (le défaut du service). À `false` le temps d'un premier essai en clair
# (`http://…:8080`) : sinon le navigateur refuse le cookie et la connexion ne
# prend pas. Repassez-le à `true` dès que le TLS est en place.
COOKIE_SECURE=false

# --- Le premier compte d'administration -------------------------------------

# Le compte est créé au PREMIER démarrage (12 caractères au minimum). Une fois le
# mot de passe changé depuis l'application, cette ligne peut être vidée — le
# compte existe, et un ADMIN_PASSWORD vide ne remplace jamais un mot de passe
# déjà posé.
ADMIN_LOGIN=admin

ADMIN_PASSWORD=

# Nom affiché du compte, et adresse de courriel (facultative : elle sert aux
# notifications et à la réinitialisation).
ADMIN_NOM=Administrateur

ADMIN_EMAIL=

# --- Le contenu -------------------------------------------------------------

# `true` installe le jeu FICTIF de démonstration (mairie de Valmont-sur-Loire :
# entités, personnes, trames, actes) — pratique pour visiter l'outil avant de
# s'engager, à ne pas garder en service. `false` ouvre un référentiel VIERGE, que
# l'administration construit elle-même.
DEMO=false
